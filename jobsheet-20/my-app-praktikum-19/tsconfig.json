{
  "compilerOptions": {
    "target": "es5",
    "types": ["node", "jest"],
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/__tests__/**/*",  // Keperluan testing
    "**/__test__/**/*",   // Keperluan testing
    "**/*.test.tsx",      // Keperluan testing
    "**/*.spec.tsx"       // Keperluan testing
  ],
  "exclude": [
    "node_modules"
  ]
}
